<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.urban.carbon.admin.infrastructure.mapper.RoleMapper">
  <resultMap id="BaseRoleResultMap" type="com.urban.carbon.admin.domain.entity.Role">
    <result property="id" column="ID"/>
    <result property="gmtCreate" column="GMT_CREATE"/>
    <result property="gmtModified" column="GMT_MODIFIED"/>
    <result property="roleName" column="ROLE_NAME" />
    <result property="rolePermission" column="ROLE_PERMISSION" />
    <result property="roleActive" column="ROLE_ACTIVE" />
    <result property="roleDesc" column="ROLE_DESC" />
    <result property="deleted" column="DELETED"/>
    <result property="lockVersion" column="LOCK_VERSION"/>
  </resultMap>

  <select id="findByRoleId" resultMap="BaseRoleResultMap">
    select * from "public"."roles" where "deleted"=0 and "role_active"=1
    <if test="roleId!=null">AND "id" = #{roleId}</if>
  </select>

  <select id="findByRoleName" resultMap="BaseRoleResultMap">
    select * from "public"."roles" where "deleted"=0 and "role_active"=1
    <if test="id!=null">AND "role_name" = #{roleName}</if>
  </select>

</mapper>
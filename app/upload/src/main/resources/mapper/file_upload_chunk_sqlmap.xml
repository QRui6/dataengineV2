<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.urban.carbon.upload.infrastructure.mapper.FileUploadChunkMapper">

  <resultMap id="BaseResultMap" type="com.urban.carbon.upload.domain.entity.FileUploadChunk">
    <id column="ID" property="id" jdbcType="BIGINT"/>
    <result column="FILE_ID" property="fileId" jdbcType="VARCHAR"/>
    <result column="CHUNK_INDEX" property="chunkIndex" jdbcType="INTEGER"/>
    <result column="CHUNK_SIZE" property="chunkSize" jdbcType="BIGINT"/>
    <result column="STATUS" property="status" jdbcType="SMALLINT"/>
    <result column="UPLOAD_TIME" property="uploadTime" jdbcType="TIMESTAMP"/>
    <result column="MD5" property="md5" jdbcType="VARCHAR"/>
    <result column="SERVER_PATH" property="serverPath" jdbcType="VARCHAR"/>
    <result column="RETRY_COUNT" property="retryCount" jdbcType="SMALLINT"/>
    <result column="DELETED" property="deleted" jdbcType="SMALLINT"/>
    <result column="LOCK_VERSION" property="lockVersion" jdbcType="INTEGER"/>
  </resultMap>

</mapper>
